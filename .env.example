# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_db?schema=public"

# Secret used to sign session JWTs — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the app (used for absolute links, e.g. in future email notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web push (demo reminder notifications) — generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@prepseven.com"

# Shared secret the demo-reminders cron endpoint checks for — must match
# the CRON_SECRET GitHub Actions secret on the repo (see
# .github/workflows/demo-reminders.yml). Generate with `openssl rand -base64 32`.
CRON_SECRET="replace-with-a-long-random-secret"
