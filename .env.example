# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_db?schema=public"

# Secret used to sign session JWTs — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the app (used for absolute links, e.g. in future email notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
